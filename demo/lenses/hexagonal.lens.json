{
  "name": "hexagonal",
  "question": "Is the backend hexagonal? Domain and ports must not import adapters.",
  "cut": { "split_files": false },
  "hide": [ "^src/", "^(docs|infra|sdlc|\\.github|\\.claude)/", "^[^/]+$" ],
  "districts": [
    { "match": "^server/", "as": "backend" }
  ],
  "blocks": [
    { "match": "^server/(domain|ports|adapters|api)/", "as": "$1" }
  ],
  "relations": [
    { "kind": "imports", "viz": "lanes", "source": "imports" },
    { "kind": "violation", "viz": "lanes", "pairs": [
      { "from": "^server/domain/order\\.ts$", "to": "server/adapters/payments/stripeGateway.ts" }
    ] }
  ]
}
