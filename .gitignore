# docs portal: symlink created by docs_website's postinstall (see docs_website/README.md)
docs/node_modules

# OS / editor cruft
.DS_Store
/target

# Claude Code local overrides — settings.json is committed, .local is not
.claude/settings.local.json

# The SDLC harness, checked out from The-Factory by every stage. Never part of
# this repository.
.factory/

# Business context as the stages see it; locally a symlink to context.
# No trailing slash: a `dir/` pattern does not match a symlink to a directory.
factory-context

# Local output of Claude sessions; never part of the repository
/Claude outputs/
demo/.cache

# Launcher render snapshots (tests/launcher_look.rs), never committed
tests/snapshots/
