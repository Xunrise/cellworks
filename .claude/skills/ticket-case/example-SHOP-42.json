      {
        "id": "P1",
        "title": "No promo field on the checkout page",
        "where": "src/ui/checkoutView.ts"
      },
      {
        "id": "P2",
        "title": "Totals know no discount",
        "where": "src/cart/totals.ts \u00b7 computeTotals()"
      },
      {
        "id": "P3",
        "title": "The order charges the undiscounted total",
        "where": "src/checkout/order.ts \u00b7 placeOrder()"
      }
    ],
